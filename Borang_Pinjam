<?php
require_once '../../config/database.php';

$mesej = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $nama = trim($_POST['nama'] ?? '');
    $tujuan = trim($_POST['tujuan'] ?? '');
    $tarikh_pinjam = $_POST['tarikh_pinjam'] ?? '';
    $tarikh_pulang = $_POST['tarikh_pulang'] ?? '';
    $jumlah_laptop = (int)($_POST['jumlah_laptop'] ?? 0);
    $jumlah_pencetak = (int)($_POST['jumlah_pencetak'] ?? 0);

    if (!empty($nama) && !empty($tujuan) && !empty($tarikh_pinjam) && !empty($tarikh_pulang)) {
        $stmt = $pdo->prepare("INSERT INTO permohonan_pinjaman 
            (nama_pemohon, tujuan, tarikh_pinjam, tarikh_pulang, jumlah_laptop, jumlah_pencetak) 
            VALUES (?, ?, ?, ?, ?, ?)");
        
        if ($stmt->execute([$nama, $tujuan, $tarikh_pinjam, $tarikh_pulang, $jumlah_laptop, $jumlah_pencetak])) {
            $mesej = "Permohonan berjaya dihantar!";
        } else {
            $mesej = "Ralat semasa menyimpan permohonan.";
        }
    } else {
        $mesej = "Sila lengkapkan semua medan wajib (*).";
    }
}
?>

